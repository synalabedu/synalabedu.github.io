# ============================================
# SYNALAB - .gitignore
# Última actualización: v1.0
# ============================================

# === Dependencias ===
node_modules/
.pnp.*
.yarn/

# === Build y caché de Astro ===
dist/
.astro/
.output/

# === Variables de entorno y secretos ===
.env
.env.local
.env.*.local
.env.production
.env.development
*.pem
*.key
*.cert
config.json
secrets.json

# === Caché de herramientas ===
.cache/
.vite/
.turbo/
.parcel-cache/

# === Logs ===
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# === IDEs y editores ===
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# === Sistema operativo ===
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# === Archivos temporales ===
*.tmp
*.temp
*.bak
*.backup

# === Coverage y testing ===
coverage/
.nyc_output/
*.lcov

# === Despliegue ===
.netlify/
.vercel/
.wrangler/

# === Backups locales del usuario ===
backup/
backups/
old/
_old/