---
import { SITE, SOCIAL, FOOTER_LINKS } from '../../lib/site';

const currentYear = new Date().getFullYear();
---
<footer class="border-t border-slate-muted/10 mt-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">

      <div class="md:col-span-5">
        <a href="/" class="inline-flex items-baseline" aria-label={`${SITE.name} — Inicio`}>
          <span class="text-2xl font-display font-bold text-gradient-synalab tracking-tight">
            SYNALAB
          </span>
        </a>
        <p class="mt-3 text-sm text-blanco-puro/70 max-w-sm">
          {SITE.descriptor}. Estudio independiente de creación de software funcional impulsado por inteligencia artificial.
        </p>
        <p class="mt-4 text-xs text-slate-muted">
          {SITE.location}
        </p>
      </div>

      <nav class="md:col-span-2" aria-label="Enlaces del estudio">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-muted mb-4">
          Estudio
        </h3>
        <ul class="space-y-3">
          {FOOTER_LINKS.estudio.map((link) => (
            <li>
                <a
                href={link.href}
                class="text-sm text-blanco-puro/80 hover:text-cyan-synalab transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav class="md:col-span-3" aria-label="Enlaces legales">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-muted mb-4">
          Legal
        </h3>
        <ul class="space-y-3">
          {FOOTER_LINKS.legal.map((link) => (
            <li>
                <a
                href={link.href}
                class="text-sm text-blanco-puro/80 hover:text-cyan-synalab transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="md:col-span-2">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-muted mb-4">
          Síguenos
        </h3>
        <ul class="flex gap-3">
          <li>
              <a
              href={SOCIAL.instagram}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram de Synalab"
              class="flex items-center justify-center w-10 h-10 rounded-md border border-slate-muted/20 text-blanco-puro/80 hover:text-cyan-synalab hover:border-cyan-synalab/40 transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </a>
          </li>
          <li>
              <a
              href={SOCIAL.facebook}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook de Synalab"
              class="flex items-center justify-center w-10 h-10 rounded-md border border-slate-muted/20 text-blanco-puro/80 hover:text-cyan-synalab hover:border-cyan-synalab/40 transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
              </svg>
            </a>
          </li>
          <li>
              <a
              href={SOCIAL.github}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub de Synalab"
              class="flex items-center justify-center w-10 h-10 rounded-md border border-slate-muted/20 text-blanco-puro/80 hover:text-cyan-synalab hover:border-cyan-synalab/40 transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
              </svg>
            </a>
          </li>
        </ul>
      </div>

    </div>

    <div class="mt-12 pt-8 border-t border-slate-muted/10 flex flex-col sm:flex-row justify-between gap-4 text-xs text-slate-muted">
      <p>
        © {currentYear} {SITE.name}. {SITE.descriptor}.
      </p>
      <p>
        Hecho con propósito en {SITE.location}.
      </p>
    </div>

  </div>
</footer>