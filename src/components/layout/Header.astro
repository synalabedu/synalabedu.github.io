---
import ThemeToggle from '../ui/ThemeToggle.astro';
import { SITE, NAVIGATION } from '../../lib/site';
import Logo from '../ui/Logo.astro';
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-navy-profundo/80 border-b border-slate-muted/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <Logo size="header" />
      <div class="flex items-center gap-3 md:gap-6">
        <nav class="hidden md:flex items-center gap-8" aria-label="Navegación principal">
          {NAVIGATION.map((item) => (
            <a href={item.href} class="text-sm text-blanco-puro/80 hover:text-cyan-synalab transition-colors">
              {item.label}
            </a>
          ))}
        </nav>
        <button type="button" class="p-2 text-blanco-puro/80 hover:text-cyan-synalab transition-colors" aria-label="Abrir búsqueda" aria-controls="search-modal" aria-expanded="false" data-search-toggle>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
        <ThemeToggle />
        <button type="button" class="md:hidden p-2 text-blanco-puro hover:text-cyan-synalab transition-colors" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-icon-menu>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden" data-icon-close>
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
    <nav id="mobile-menu" class="md:hidden hidden flex-col gap-4 pb-4 border-t border-slate-muted/10 pt-4" aria-label="Navegación principal móvil" data-mobile-menu>
      {NAVIGATION.map((item) => (
        <a href={item.href} class="text-base text-blanco-puro/80 hover:text-cyan-synalab transition-colors py-2">
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<div id="search-modal" class="fixed inset-0 z-[100] hidden items-start justify-center p-4 md:pt-20" role="dialog" aria-modal="true" aria-labelledby="search-modal-title">
  <div class="absolute inset-0 bg-navy-profundo/85 backdrop-blur-md" data-search-backdrop></div>
  <div class="relative w-full max-w-2xl bg-navy-profundo border border-blanco-puro/10 rounded-2xl shadow-2xl overflow-hidden">
    <div class="flex items-center justify-between px-6 pt-5 pb-3 border-b border-blanco-puro/10">
      <p id="search-modal-title" class="text-sm font-semibold tracking-wider uppercase text-cyan-synalab">
        Buscar en el sitio
      </p>
      <button type="button" class="text-blanco-puro/60 hover:text-cyan-synalab transition-colors" aria-label="Cerrar búsqueda" data-search-close>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="p-6 max-h-[70vh] overflow-y-auto">
      <div id="search-modal-content"></div>
      <p class="mt-6 text-xs text-slate-muted flex items-center gap-2">
        Atajos:
        <kbd class="px-1.5 py-0.5 rounded bg-blanco-puro/[0.05] border border-blanco-puro/10 font-mono text-[10px]">Esc</kbd>
        para cerrar,
        <kbd class="px-1.5 py-0.5 rounded bg-blanco-puro/[0.05] border border-blanco-puro/10 font-mono text-[10px]">Ctrl/⌘</kbd>
        +
        <kbd class="px-1.5 py-0.5 rounded bg-blanco-puro/[0.05] border border-blanco-puro/10 font-mono text-[10px]">K</kbd>
        para abrir.
      </p>
    </div>
  </div>
</div>

{import.meta.env.PROD && (
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
)}
{import.meta.env.PROD && (
  <script src="/pagefind/pagefind-ui.js" is:inline></script>
)}

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const menu = document.querySelector('[data-mobile-menu]');
  const iconMenu = document.querySelector('[data-icon-menu]');
  const iconClose = document.querySelector('[data-icon-close]');
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    menu?.classList.toggle('flex', isOpen);
    iconMenu?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
  });
</script>

<script is:inline>
  (function () {
    var searchToggle = document.querySelector('[data-search-toggle]');
    var searchModal = document.getElementById('search-modal');
    var searchClose = document.querySelector('[data-search-close]');
    var searchBackdrop = document.querySelector('[data-search-backdrop]');
    var searchContent = document.getElementById('search-modal-content');
    var pagefindInitialized = false;

    function showFallback() {
      if (searchContent && !searchContent.innerHTML) {
        searchContent.innerHTML = '<p style="padding: 1rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.03); color: rgba(255,255,255,0.7); font-size: 14px;">La búsqueda solo funciona en el sitio publicado. En desarrollo local, ejecuta <code style="color: var(--color-cyan-synalab);">npm run build &amp;&amp; npm run preview</code> para probarla.</p>';
      }
    }

    function initPagefind() {
      if (pagefindInitialized) return;
      if (typeof PagefindUI === 'undefined') {
        showFallback();
        return;
      }
      new PagefindUI({
        element: '#search-modal-content',
        showSubResults: true,
        showImages: false,
        resetStyles: false,
        translations: {
          placeholder: 'Buscar en el sitio…',
          clear_search: 'Limpiar',
          load_more: 'Cargar más resultados',
          search_label: 'Buscar en el sitio',
          filters_label: 'Filtros',
          zero_results: 'No se encontraron resultados para [SEARCH_TERM]',
          many_results: '[COUNT] resultados para [SEARCH_TERM]',
          one_result: '1 resultado para [SEARCH_TERM]',
          alt_search: 'No se encontraron resultados para [SEARCH_TERM]. Mostrando resultados para [DIFFERENT_TERM]',
          search_suggestion: 'No se encontraron resultados para [SEARCH_TERM]. Intenta con:',
          searching: 'Buscando [SEARCH_TERM]…'
        }
      });
      pagefindInitialized = true;
    }

    function openModal() {
      if (!searchModal) return;
      searchModal.classList.remove('hidden');
      searchModal.classList.add('flex');
      searchToggle && searchToggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      initPagefind();
      setTimeout(function () {
        var input = searchModal.querySelector('.pagefind-ui__search-input');
        if (input) input.focus();
      }, 50);
    }

    function closeModal() {
      if (!searchModal) return;
      searchModal.classList.add('hidden');
      searchModal.classList.remove('flex');
      searchToggle && searchToggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    searchToggle && searchToggle.addEventListener('click', openModal);
    searchClose && searchClose.addEventListener('click', closeModal);
    searchBackdrop && searchBackdrop.addEventListener('click', closeModal);

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && searchModal && !searchModal.classList.contains('hidden')) {
        closeModal();
      }
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        if (searchModal && searchModal.classList.contains('hidden')) {
          openModal();
        } else {
          closeModal();
        }
      }
    });
  })();
</script>

<style is:global>
  .pagefind-ui {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--color-cyan-synalab);
    --pagefind-ui-text: var(--color-blanco-puro);
    --pagefind-ui-background: transparent;
    --pagefind-ui-border: rgb(from var(--color-blanco-puro) r g b / 0.1);
    --pagefind-ui-tag: rgb(from var(--color-blanco-puro) r g b / 0.05);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-image-border-radius: 6px;
    --pagefind-ui-image-box-ratio: 3 / 2;
    --pagefind-ui-font: inherit;
  }
  .pagefind-ui__search-input {
    background-color: rgb(from var(--color-blanco-puro) r g b / 0.03) !important;
    color: var(--color-blanco-puro) !important;
    border-color: rgb(from var(--color-blanco-puro) r g b / 0.1) !important;
  }
  .pagefind-ui__search-input::placeholder {
    color: rgb(from var(--color-blanco-puro) r g b / 0.4) !important;
  }
  .pagefind-ui__search-input:focus {
    border-color: var(--color-cyan-synalab) !important;
    outline: none !important;
    box-shadow: 0 0 0 3px rgb(from var(--color-cyan-synalab) r g b / 0.15) !important;
  }
  .pagefind-ui__search-clear {
    color: var(--color-cyan-synalab) !important;
  }
  .pagefind-ui__result {
    border-color: rgb(from var(--color-blanco-puro) r g b / 0.1) !important;
    padding: 1rem 0 !important;
  }
  .pagefind-ui__result-link {
    color: var(--color-blanco-puro) !important;
    font-weight: 600 !important;
    transition: color 0.2s !important;
  }
  .pagefind-ui__result-link:hover {
    color: var(--color-cyan-synalab) !important;
  }
  .pagefind-ui__result-excerpt {
    color: rgb(from var(--color-blanco-puro) r g b / 0.7) !important;
    line-height: 1.6 !important;
    font-size: 0.875rem !important;
  }
  .pagefind-ui__result-excerpt mark {
    background-color: rgb(from var(--color-cyan-synalab) r g b / 0.2) !important;
    color: var(--color-cyan-synalab) !important;
    padding: 0 0.25rem !important;
    border-radius: 3px !important;
    font-weight: 600 !important;
  }
  .pagefind-ui__message {
    color: rgb(from var(--color-blanco-puro) r g b / 0.7) !important;
  }
  .pagefind-ui__button {
    background-color: rgb(from var(--color-cyan-synalab) r g b / 0.1) !important;
    color: var(--color-cyan-synalab) !important;
    border: 1px solid rgb(from var(--color-cyan-synalab) r g b / 0.3) !important;
    border-radius: 8px !important;
    transition: all 0.2s !important;
  }
  .pagefind-ui__button:hover {
    background-color: rgb(from var(--color-cyan-synalab) r g b / 0.2) !important;
  }
</style>