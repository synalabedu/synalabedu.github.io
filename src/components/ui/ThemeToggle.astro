---
/**
 * Toggle visual de tema claro/oscuro.
 *
 * Estado inicial: maneja el script anti-flash en Layout.astro
 * (lee localStorage o prefers-color-scheme y setea data-theme antes
 *  del primer pintado).
 *
 * Aquí solo:
 * - Renderizado de iconos (sol/luna) que se intercambian via CSS según data-theme
 * - Handler de click que actualiza data-theme + localStorage
 */
---
<button
  type="button"
  data-theme-toggle
  class="flex items-center justify-center w-10 h-10 rounded-md text-blanco-puro/80 hover:text-cyan-synalab hover:bg-blanco-puro/[0.05] transition-colors"
  aria-label="Cambiar tema"
  title="Cambiar tema"
>
  <!-- Sol: visible en tema oscuro (representa "cambiar a claro") -->
  <svg
    class="theme-icon-sun"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>

  <!-- Luna: visible en tema claro (representa "cambiar a oscuro") -->
  <svg
    class="theme-icon-moon"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<style>
  /* Por defecto (tema oscuro): muestra sol, oculta luna */
  .theme-icon-sun { display: block; }
  .theme-icon-moon { display: none; }

  /* Tema claro: muestra luna, oculta sol */
  html[data-theme="light"] .theme-icon-sun { display: none; }
  html[data-theme="light"] .theme-icon-moon { display: block; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    if (!button) return;

    button.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('synalab-theme', next);
    });
  });
</script>