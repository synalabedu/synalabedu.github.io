---
import WhatsAppFloat from '../components/ui/WhatsAppFloat.astro';
import Layout from '../layouts/Layout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import { SITE, SOCIAL } from '../lib/site';

const inputClasses = 'w-full px-4 py-3 rounded-md border border-blanco-puro/10 bg-blanco-puro/[0.02] text-blanco-puro placeholder:text-blanco-puro/30 focus:border-cyan-synalab/50 focus:bg-blanco-puro/[0.04] focus:outline-none transition-colors';
const labelClasses = 'block text-sm font-medium text-blanco-puro/80 mb-2';
---
<Layout
  title="Contacto"
  description="Conversemos sobre tu consulta, formación o cualquier inquietud. Synalab está abierto a problemas reales que merezcan soluciones bien construidas."
>
  <section>
    <Container class="py-24 md:py-32">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold tracking-wider uppercase text-cyan-synalab mb-6">
          Contacto
        </p>
        <h1 class="text-5xl md:text-6xl font-bold leading-[1.05] tracking-tight mb-8">
          Cuéntanos en qué podemos <span class="text-gradient-synalab">ayudarte</span>
        </h1>
        <p class="text-lg md:text-xl text-blanco-puro/80 leading-relaxed">
          Este espacio está destinado a consultas generales, formación, proyectos del laboratorio o cualquier conversación relacionada con Synalab. Si necesitas una solución desarrollada a medida, utiliza el <a href="/contacto/desarrollo" class="text-cyan-synalab underline decoration-cyan-synalab/40 underline-offset-2 hover:decoration-cyan-synalab/80 transition-colors"> formulario específico para propuestas de proyecto</a>.
        </p>
      </div>
    </Container>
  </section>

  <section>
    <Container class="py-12 md:py-16">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-8 rounded-lg border border-blanco-puro/10 bg-blanco-puro/[0.03] backdrop-blur-sm">
          <div class="w-12 h-12 rounded-md bg-cyan-synalab/10 flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-cyan-synalab" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <p class="text-xs font-semibold tracking-wider uppercase text-slate-muted mb-2">Correo</p>
          <a href={`mailto:${SITE.email}`} class="text-base text-blanco-puro hover:text-cyan-synalab transition-colors break-all">
            {SITE.email}
          </a>
        </div>

        <div class="p-8 rounded-lg border border-blanco-puro/10 bg-blanco-puro/[0.03] backdrop-blur-sm">
          <div class="w-12 h-12 rounded-md bg-violet-deep/10 flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-violet-deep" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <p class="text-xs font-semibold tracking-wider uppercase text-slate-muted mb-2">Ubicación</p>
          <p class="text-base text-blanco-puro mb-1">{SITE.location}</p>
          <p class="text-sm text-blanco-puro/60">Presencial · En línea para Colombia y la región</p>
        </div>

        <div class="p-8 rounded-lg border border-blanco-puro/10 bg-blanco-puro/[0.03] backdrop-blur-sm">
          <div class="w-12 h-12 rounded-md bg-electric-blue/10 flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-electric-blue" aria-hidden="true">
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
            </svg>
          </div>
          <p class="text-xs font-semibold tracking-wider uppercase text-slate-muted mb-3">Redes</p>
          <ul class="flex gap-3">
            <li>
              <a href={SOCIAL.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram de Synalab" class="flex items-center justify-center w-10 h-10 rounded-md border border-blanco-puro/10 text-blanco-puro/80 hover:text-cyan-synalab hover:border-cyan-synalab/40 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </a>
            </li>
            <li>
              <a href={SOCIAL.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook de Synalab" class="flex items-center justify-center w-10 h-10 rounded-md border border-blanco-puro/10 text-blanco-puro/80 hover:text-cyan-synalab hover:border-cyan-synalab/40 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                </svg>
              </a>
            </li>
            <li>
              <a href={SOCIAL.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub de Synalab" class="flex items-center justify-center w-10 h-10 rounded-md border border-blanco-puro/10 text-blanco-puro/80 hover:text-cyan-synalab hover:border-cyan-synalab/40 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                </svg>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </Container>
  </section>

  <section>
    <Container class="py-12 md:py-16">
      <div class="max-w-3xl mx-auto">
        <div class="p-8 md:p-12 rounded-2xl border border-blanco-puro/10 bg-blanco-puro/[0.03] backdrop-blur-sm">
          <p class="text-sm font-semibold tracking-wider uppercase text-cyan-synalab mb-4">
            Mensaje general
          </p>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4">
            Para iniciar una conversación
          </h2>
          <p class="text-base text-blanco-puro/70 mb-8 leading-relaxed">
            Comparte brevemente tu consulta, interés o necesidad. Este espacio está destinado a formación, proyectos del laboratorio, acceso a recursos específicos o cualquier tema relacionado con Synalab.
          </p>
          <form action="https://formspree.io/f/mykaypnp" method="POST" class="space-y-5" data-contact-form>
            <input type="hidden" name="_subject" value="Synalab — Consulta general" />
            <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

            <div>
              <label for="nombre" class={labelClasses}>Nombre</label>
              <input type="text" id="nombre" name="nombre" required maxlength="80" autocomplete="name" placeholder="Tu nombre" class={inputClasses} />
            </div>
            <div>
              <label for="email" class={labelClasses}>Correo electrónico</label>
              <input type="email" id="email" name="email" required maxlength="120" autocomplete="email" placeholder="nombre@correo.com" class={inputClasses} />
            </div>
            <div>
              <label for="asunto" class={labelClasses}>
                Asunto <span class="text-slate-muted font-normal">(opcional)</span>
              </label>
              <input type="text" id="asunto" name="asunto" maxlength="120" placeholder="Sobre qué nos escribes" class={inputClasses} />
            </div>
            <div>
              <label for="mensaje" class={labelClasses}>Mensaje</label>
              <textarea id="mensaje" name="mensaje" required maxlength="1500" rows="6" placeholder="Cuéntanos brevemente de qué se trata" class={inputClasses}></textarea>
            </div>

            <div class="flex items-start gap-3 pt-2">
              <input type="checkbox" id="consent-general" name="consent" required value="aceptado" class="mt-1 w-4 h-4 rounded border-blanco-puro/20 bg-navy-profundo accent-cyan-synalab cursor-pointer flex-shrink-0" />
              <label for="consent-general" class="text-sm text-blanco-puro/70 leading-relaxed cursor-pointer">
                He leído y acepto la <a href="/legal/privacidad" class="text-cyan-synalab underline decoration-cyan-synalab/40 underline-offset-2 hover:decoration-cyan-synalab/80 transition-colors">Política de privacidad</a> y autorizo a Synalab el tratamiento de mis datos personales para responder esta consulta.
              </label>
            </div>

            <div data-form-error class="hidden p-4 rounded-md border border-red-500/30 bg-red-500/10 text-sm text-red-200" role="alert"></div>

            <div class="pt-2">
              <Button type="submit" variant="primary">Enviar mensaje</Button>
            </div>
          </form>
        </div>
      </div>
    </Container>
  </section>

  <section>
    <Container class="py-12 md:py-16">
      <div class="max-w-3xl mx-auto">
        <div class="p-8 md:p-10 rounded-2xl border border-cyan-synalab/30 bg-cyan-synalab/[0.05] backdrop-blur-md">
          <p class="text-sm font-semibold tracking-wider uppercase text-cyan-synalab mb-4">
            ¿Tienes un proyecto de desarrollo a medida?
          </p>
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-4">
            Hay un formulario específico para eso.
          </h2>
          <p class="text-base text-blanco-puro/80 leading-relaxed mb-6">
            Si necesitas una solución diseñada para un problema particular, utiliza el formulario de desarrollo. La información solicitada nos permite comprender el alcance del proyecto y evaluar su viabilidad antes de preparar una propuesta inicial.
          </p>
          <Button href="/contacto/desarrollo" variant="primary">
            Ir al formulario de desarrollo
          </Button>
        </div>
      </div>
    </Container>
  </section>

  <section>
    <Container class="py-20 md:py-28">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-6">
          ¿Aún no sabes si tu idea encaja?
        </h2>
        <p class="text-lg text-blanco-puro/80 mb-8 leading-relaxed">
          Conoce primero el manifiesto del laboratorio y al estudio. Te dará claridad sobre cómo trabajamos y qué tipo de problemas resolvemos aquí.
        </p>
        <div class="flex flex-wrap gap-3 justify-center">
          <Button href="/manifiesto" variant="secondary">Leer el manifiesto</Button>
          <Button href="/estudio" variant="secondary">Conocer al estudio</Button>
        </div>
      </div>
    </Container>
  </section>
  <script>
  document.querySelectorAll('form[data-contact-form]').forEach((form) => {
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const errorBox = form.querySelector('[data-form-error]') as HTMLElement | null;
    const originalBtnHTML = submitBtn ? submitBtn.innerHTML : 'Enviar';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Reset error display
      if (errorBox) {
        errorBox.classList.add('hidden');
        errorBox.textContent = '';
      }

      // Disable button, show loading state
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = 'Enviando...';
        submitBtn.style.opacity = '0.6';
      }

      try {
        const formData = new FormData(form as HTMLFormElement);
        const response = await fetch((form as HTMLFormElement).action, {
          method: 'POST',
          body: formData,
          headers: { Accept: 'application/json' }
        });

        if (response.ok) {
          window.location.href = '/contacto/gracias';
          return;
        }

        let errorMessage = 'No se pudo enviar el mensaje. Por favor intenta de nuevo en unos minutos.';
        try {
          const data = await response.json();
          if (data && data.errors && data.errors.length > 0) {
            errorMessage = data.errors.map((err: { message: string }) => err.message).join('. ');
          }
        } catch {}

        showError(errorMessage);
      } catch {
        showError('No se pudo conectar con el servicio. Revisa tu conexión e intenta de nuevo.');
      }

      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalBtnHTML;
        submitBtn.style.opacity = '1';
      }
    });

    function showError(message: string) {
      if (errorBox) {
        errorBox.textContent = message;
        errorBox.classList.remove('hidden');
        errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        alert(message);
      }
    }
  });
</script>
<WhatsAppFloat message="Hola Synalab, escribo desde el sitio web para una consulta general." />
</Layout>