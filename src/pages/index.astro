---
import Layout from '../layouts/Layout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
import { getCollection } from 'astro:content';
import ProjectCover from '../components/ui/ProjectCover.astro';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const allServices = await getCollection('services');
const services = allServices.sort((a, b) => a.data.order - b.data.order);
---
<Layout>

  <section>
    <Container class="py-24 md:py-32">
      <div class="max-w-4xl">
        <p class="text-sm font-semibold tracking-wider uppercase text-cyan-synalab mb-6">
          Educación Tecnológica Consciente
        </p>
        <h1 class="text-5xl md:text-7xl font-bold leading-[1.05] tracking-tight mb-8">
          Construimos software funcional con
          <span class="text-gradient-synalab">criterio humano</span>
          y rigor técnico
        </h1>
        <p class="text-lg md:text-xl text-blanco-puro/80 max-w-2xl mb-10 leading-relaxed">
          Estudio independiente de creación de software asistido por inteligencia artificial. Cada herramienta surge de una necesidad real, se desarrolla bajo protocolos propios de seguridad y se entrega como una solución funcional, aplicable y con propósito definido.
        </p>
        <div class="flex flex-wrap gap-4">
          <Button href="/laboratorio" variant="primary" size="lg">
            Explorar el laboratorio
          </Button>
          <Button href="/contacto" variant="secondary" size="lg">
            Hablemos de tu proyecto
          </Button>
        </div>
      </div>
    </Container>
  </section>

  <section>
    <Container class="py-20 md:py-28">
      <div class="max-w-2xl mb-16">
        <p class="text-sm font-semibold tracking-wider uppercase text-cyan-synalab mb-4">
          El estilo Synalab
        </p>
        <h2 class="text-4xl md:text-5xl font-bold tracking-tight">
          Tres capacidades que rara vez coinciden
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <div class="p-8 rounded-lg border border-blanco-puro/10 bg-blanco-puro/[0.03] backdrop-blur-sm hover:border-cyan-synalab/40 hover:bg-blanco-puro/[0.05] transition-all">
          <div class="w-12 h-12 rounded-md bg-cyan-synalab/10 flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-cyan-synalab" aria-hidden="true">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
              <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">Comprensión contextual</h3>
          <p class="text-blanco-puro/70 leading-relaxed">
            Cada herramienta nace de observar necesidades reales antes que tendencias. La experiencia pedagógica aporta criterio para entender el problema, definir prioridades y construir soluciones que realmente tengan sentido en su contexto.
          </p>
        </div>

        <div class="p-8 rounded-lg border border-blanco-puro/10 bg-blanco-puro/[0.03] backdrop-blur-sm hover:border-cyan-synalab/40 hover:bg-blanco-puro/[0.05] transition-all">
          <div class="w-12 h-12 rounded-md bg-violet-deep/10 flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-violet-deep" aria-hidden="true">
              <rect x="4" y="4" width="16" height="16" rx="2"></rect>
              <rect x="9" y="9" width="6" height="6"></rect>
              <path d="M9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">Construcción con IA</h3>
          <p class="text-blanco-puro/70 leading-relaxed">
            Vibe coding con propósito. La inteligencia artificial amplía la capacidad de diseñar, iterar y desarrollar software; el criterio humano sigue definiendo qué vale la pena construir y por qué hacerlo.
          </p>
        </div>

        <div class="p-8 rounded-lg border border-blanco-puro/10 bg-blanco-puro/[0.03] backdrop-blur-sm hover:border-cyan-synalab/40 hover:bg-blanco-puro/[0.05] transition-all">
          <div class="w-12 h-12 rounded-md bg-electric-blue/10 flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-electric-blue" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">Protocolo propio</h3>
          <p class="text-blanco-puro/70 leading-relaxed">
            Quince reglas de seguridad aplicadas a cada línea de código. Arquitectura local-first por diseño y desarrollo orientado a la autonomía tecnológica. Los datos del usuario permanecen bajo control del usuario.
          </p>
        </div>

      </div>
    </Container>
  </section>

  <section>
    <Container class="py-20 md:py-28">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
        <div class="max-w-2xl">
          <p class="text-sm font-semibold tracking-wider uppercase text-cyan-synalab mb-4">
            Del laboratorio
          </p>
          <h2 class="text-4xl md:text-5xl font-bold tracking-tight">
            Herramientas construidas con propósito
          </h2>
        </div>
        <Button href="/laboratorio" variant="ghost">
          Ver todos →
        </Button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {featuredProjects.map((project) => (
          <a href={"/laboratorio/" + project.id} class="group rounded-lg border border-blanco-puro/10 bg-blanco-puro/[0.03] backdrop-blur-sm hover:border-cyan-synalab/40 hover:bg-blanco-puro/[0.05] transition-all flex flex-col overflow-hidden">
            <ProjectCover project={project} aspectRatio="video" rounded="lg" />
            <div class="p-6 flex flex-col flex-grow">
              <div class="flex items-center justify-between mb-4">
                <Badge variant={project.data.status} />
                {project.data.version && (
                  <span class="text-xs text-slate-muted font-mono">{project.data.version}</span>
                )}
              </div>
              <h3 class="text-2xl font-semibold mb-3 group-hover:text-cyan-synalab transition-colors">
                {project.data.name}
              </h3>
              <p class="text-blanco-puro/70 leading-relaxed mb-6 flex-grow">
                {project.data.tagline}
              </p>
              <span class="text-sm text-cyan-synalab font-medium">
                Ver detalle →
              </span>
            </div>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <section>
    <Container class="py-20 md:py-28">
      <div class="max-w-2xl mb-16">
        <p class="text-sm font-semibold tracking-wider uppercase text-cyan-synalab mb-4">
          Cómo trabajamos contigo
        </p>
        <h2 class="text-4xl md:text-5xl font-bold tracking-tight">
          Tres formas de colaborar
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {services.map((service) => (
          <div class="p-8 rounded-lg border border-blanco-puro/10 bg-blanco-puro/[0.03] backdrop-blur-sm flex flex-col">
            <h3 class="text-xl font-semibold mb-3">{service.data.name}</h3>
            <p class="text-cyan-synalab text-sm mb-4 italic">{service.data.tagline}</p>
            <p class="text-blanco-puro/70 leading-relaxed mb-8 flex-grow">
              {service.data.description}
            </p>
            <a
              href={service.data.href}
              class="text-sm font-medium text-blanco-puro/80 hover:text-cyan-synalab transition-colors"
            >
              {service.data.cta} →
            </a>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <section>
    <Container class="py-20 md:py-28">
      <div class="relative max-w-3xl mx-auto overflow-hidden rounded-2xl border border-blanco-puro/10 bg-blanco-puro/[0.03] backdrop-blur-md p-10 md:p-14">
        <p class="text-sm font-semibold tracking-wider uppercase text-cyan-synalab mb-6">
          Empezamos cuando el problema lo justifica
        </p>
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-6">
          ¿Existe un problema real que merezca una solución?
        </h2>
        <p class="text-lg text-blanco-puro/80 mb-10 leading-relaxed">
          Las mejores herramientas nacen de necesidades reales. Si tienes una, hablemos.
        </p>
        <Button href="/contacto" variant="primary" size="lg">
          Hablemos de tu proyecto
        </Button>
      </div>
    </Container>
  </section>

</Layout>