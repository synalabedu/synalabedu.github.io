---
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import ProjectCover from '../../components/ui/ProjectCover.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import TagBadge from '../../components/ui/TagBadge.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;

const allProjects = await getCollection('projects');
const relatedProjects = allProjects
  .filter((p) => p.id !== project.id && p.data.category === data.category)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const categoryLabels: Record<string, string> = {
  educacion: 'Educación',
  gestion: 'Gestión',
  productividad: 'Productividad',
};

const licenseLabels: Record<string, string> = {
  'cc-by': 'CC BY 4.0 — Atribución',
  'cc-by-sa': 'CC BY-SA 4.0 — Atribución, Compartir Igual',
  'cc-by-nc': 'CC BY-NC 4.0 — Atribución, No Comercial',
  'cc-by-nc-sa': 'CC BY-NC-SA 4.0 — Atribución, No Comercial, Compartir Igual',
  'cc-by-nd': 'CC BY-ND 4.0 — Atribución, Sin Derivar',
  'cc-by-nc-nd': 'CC BY-NC-ND 4.0 — Atribución, No Comercial, Sin Derivar',
  'cc0': 'CC0 1.0 — Dominio Público',
  'proprietary': 'Licencia propietaria',
  'mit': 'Licencia MIT',
  'gpl-3': 'Licencia GNU GPL v3',
};

const licenseDescriptions: Record<string, string> = {
  'cc-by': 'Puedes compartir y adaptar este trabajo con cualquier propósito, incluso comercial, siempre que des crédito apropiado al autor original.',
  'cc-by-sa': 'Puedes compartir y adaptar este trabajo, incluso para uso comercial, siempre que des crédito y compartas tus modificaciones bajo la misma licencia.',
  'cc-by-nc': 'Puedes compartir y adaptar este trabajo para fines no comerciales, dando crédito apropiado al autor original.',
  'cc-by-nc-sa': 'Puedes compartir y adaptar este trabajo para fines no comerciales, dando crédito apropiado y compartiendo cualquier obra derivada bajo la misma licencia.',
  'cc-by-nd': 'Puedes compartir este trabajo, incluso para uso comercial, sin modificarlo y dando crédito apropiado al autor original.',
  'cc-by-nc-nd': 'Puedes compartir este trabajo solo para fines no comerciales, sin modificarlo y dando crédito apropiado al autor original.',
  'cc0': 'Este trabajo está liberado al dominio público. Puedes usarlo, copiarlo, modificarlo y distribuirlo sin restricciones de copyright.',
  'proprietary': 'Este proyecto tiene licencia propietaria de Synalab. Para condiciones de uso, distribución o modificación, contáctanos directamente.',
  'mit': 'Software libre bajo licencia MIT. Puedes usarlo, modificarlo y distribuirlo, incluso comercialmente, manteniendo el aviso de copyright original.',
  'gpl-3': 'Software libre bajo licencia GNU GPL v3. Cualquier obra derivada debe distribuirse también bajo la misma licencia.',
};

const licenseUrls: Record<string, string> = {
  'cc-by': 'https://creativecommons.org/licenses/by/4.0/deed.es',
  'cc-by-sa': 'https://creativecommons.org/licenses/by-sa/4.0/deed.es',
  'cc-by-nc': 'https://creativecommons.org/licenses/by-nc/4.0/deed.es',
  'cc-by-nc-sa': 'https://creativecommons.org/licenses/by-nc-sa/4.0/deed.es',
  'cc-by-nd': 'https://creativecommons.org/licenses/by-nd/4.0/deed.es',
  'cc-by-nc-nd': 'https://creativecommons.org/licenses/by-nc-nd/4.0/deed.es',
  'cc0': 'https://creativecommons.org/publicdomain/zero/1.0/deed.es',
  'proprietary': '',
  'mit': 'https://opensource.org/licenses/MIT',
  'gpl-3': 'https://www.gnu.org/licenses/gpl-3.0.html',
};
---
<Layout title={data.name} description={data.description}>

  <section>
    <Container class="py-24 md:py-32">
      <div class="max-w-5xl mx-auto mb-12">
        <a href="/laboratorio" class="inline-block mb-8 text-sm text-cyan-synalab hover:text-cyan-synalab/80 transition-colors">
          ← Volver al laboratorio
        </a>
        <ProjectCover project={project} aspectRatio="wide" rounded="2xl" />
      </div>

      <div class="max-w-3xl">
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <Badge variant={data.status} />
          {data.version && (
            <span class="text-sm text-slate-muted font-mono">{data.version}</span>
          )}
          <span class="text-sm text-slate-muted">·</span>
          <span class="text-sm text-cyan-synalab">{categoryLabels[data.category] || data.category}</span>
        </div>

        <h1 class="text-5xl md:text-6xl font-bold leading-[1.05] tracking-tight mb-6">
          {data.name}
        </h1>
        <p class="text-xl md:text-2xl text-blanco-puro/90 leading-relaxed mb-8">
          {data.tagline}
        </p>
        <p class="text-lg text-blanco-puro/80 leading-relaxed">
          {data.description}
        </p>

        {data.accessModel === 'acuerdo' ? (
          <div class="flex flex-wrap gap-3 mt-10">
            <Button href="/contacto" variant="primary">Hablemos sobre este proyecto</Button>
            {data.documentationUrl && (
              <Button href={data.documentationUrl} variant="secondary">Documentación</Button>
            )}
          </div>
        ) : (data.downloadUrl || data.documentationUrl) && (
          <div class="flex flex-wrap gap-3 mt-10">
            {data.downloadUrl && (
              <Button href={data.downloadUrl} variant="primary">Descargar</Button>
            )}
            {data.documentationUrl && (
              <Button href={data.documentationUrl} variant="secondary">Documentación</Button>
            )}
          </div>
        )}
      </div>
    </Container>
  </section>

  {data.accessModel === 'acuerdo' && (
    <section>
      <Container class="py-12 md:py-16">
        <div class="max-w-3xl mx-auto">
          <div class="rounded-2xl border border-cyan-synalab/30 bg-cyan-synalab/[0.05] backdrop-blur-md p-8 md:p-10">
            <p class="text-sm font-semibold tracking-wider uppercase text-cyan-synalab mb-4">
              Proyecto de acceso por acuerdo
            </p>
            <h2 class="text-2xl md:text-3xl font-bold mb-4 tracking-tight">
              Este proyecto requiere conversación previa
            </h2>
            <p class="text-blanco-puro/80 leading-relaxed mb-4">
              Por su envergadura técnica y su alcance operativo, {data.name} no se ofrece como descarga directa desde el sitio. Su acceso se define caso por caso mediante un acuerdo específico de uso, ajustado al contexto del solicitante: tipo de organización, problema a resolver, necesidad de personalización y modelo de soporte.
            </p>
            <p class="text-blanco-puro/80 leading-relaxed mb-6">
              Esta diferenciación no compromete la misión pedagógica del estudio: refleja que ciertas soluciones requieren un acompañamiento técnico más cercano y un modelo sostenible de continuidad.
            </p>
            <Button href="/contacto" variant="primary">
              Iniciar conversación
            </Button>
          </div>
        </div>
      </Container>
    </section>
  )}

  {data.problem && (
    <section>
      <Container class="py-16 md:py-20">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold tracking-wider uppercase text-cyan-synalab mb-4">El problema</p>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-6">¿Qué resuelve?</h2>
          <p class="text-lg text-blanco-puro/80 leading-relaxed">{data.problem}</p>
        </div>
      </Container>
    </section>
  )}

  {data.solution && (
    <section>
      <Container class="py-16 md:py-20">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold tracking-wider uppercase text-cyan-synalab mb-4">La solución</p>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-6">Cómo lo resuelve</h2>
          <p class="text-lg text-blanco-puro/80 leading-relaxed">{data.solution}</p>
        </div>
      </Container>
    </section>
  )}

  {data.features && data.features.length > 0 && (
    <section>
      <Container class="py-16 md:py-20">
        <div class="max-w-5xl">
          <p class="text-sm font-semibold tracking-wider uppercase text-cyan-synalab mb-4">Características</p>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-12">Lo que hace</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {data.features.map((feature) => (
              <div class="p-6 rounded-lg border border-blanco-puro/10 bg-blanco-puro/[0.03] backdrop-blur-sm">
                <h3 class="text-lg font-semibold mb-3">{feature.title}</h3>
                <p class="text-blanco-puro/70 leading-relaxed">{feature.description}</p>
              </div>
            ))}
          </div>
        </div>
      </Container>
    </section>
  )}

  {data.images && data.images.length > 0 && (
    <section>
      <Container class="py-16 md:py-20">
        <div class="max-w-5xl">
          <p class="text-sm font-semibold tracking-wider uppercase text-cyan-synalab mb-4">Galería</p>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-12">En funcionamiento</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {data.images.map((image) => (
              <figure class="rounded-lg overflow-hidden border border-blanco-puro/10 bg-blanco-puro/[0.03]">
                <img src={image.src} alt={image.alt} class="w-full h-auto" loading="lazy" />
                {image.caption && (
                  <figcaption class="px-4 py-3 text-sm text-blanco-puro/70 border-t border-blanco-puro/10">
                    {image.caption}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        </div>
      </Container>
    </section>
  )}

  {(data.techStack || data.requirements || data.targetAudience || data.scormCompatible) && (
    <section>
      <Container class="py-16 md:py-20">
        <div class="max-w-5xl">
          <p class="text-sm font-semibold tracking-wider uppercase text-cyan-synalab mb-4">Ficha técnica</p>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-12">Detalles del proyecto</h2>
          <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8">
            {data.techStack && data.techStack.length > 0 && (
              <div>
                <dt class="text-xs font-semibold tracking-wider uppercase text-slate-muted mb-3">Tecnologías</dt>
                <dd class="flex flex-wrap gap-2">
                  {data.techStack.map((tech) => (
                    <span class="px-3 py-1.5 text-sm rounded-full border border-blanco-puro/10 bg-blanco-puro/[0.03] text-blanco-puro/80">
                      {tech}
                    </span>
                  ))}
                </dd>
              </div>
            )}
            {data.requirements && (
              <div>
                <dt class="text-xs font-semibold tracking-wider uppercase text-slate-muted mb-3">Requisitos</dt>
                <dd class="text-base text-blanco-puro/80 leading-relaxed">{data.requirements}</dd>
              </div>
            )}
            {data.targetAudience && (
              <div>
                <dt class="text-xs font-semibold tracking-wider uppercase text-slate-muted mb-3">Audiencia objetivo</dt>
                <dd class="text-base text-blanco-puro/80 leading-relaxed">{data.targetAudience}</dd>
              </div>
            )}
            {data.scormCompatible && (
              <div>
                <dt class="text-xs font-semibold tracking-wider uppercase text-slate-muted mb-3">Compatibilidad</dt>
                <dd class="text-base text-blanco-puro/80 leading-relaxed">
                  Compatible con SCORM para integración en plataformas LMS como Moodle.
                </dd>
              </div>
            )}
          </dl>
        </div>
      </Container>
    </section>
  )}

  {data.tags && data.tags.length > 0 && (
    <section>
      <Container class="py-12 md:py-16">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold tracking-wider uppercase text-cyan-synalab mb-4">Etiquetas</p>
          <div class="flex flex-wrap gap-2">
            {data.tags.map((tag) => (
              <TagBadge tag={tag} section="laboratorio" size="md" />
            ))}
          </div>
        </div>
      </Container>
    </section>
  )}

  <section>
    <Container class="py-16 md:py-20">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold tracking-wider uppercase text-cyan-synalab mb-4">Privacidad y seguridad</p>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-6">Datos respetados, código auditado</h2>
        <p class="text-lg text-blanco-puro/80 leading-relaxed">
          Como toda herramienta del laboratorio, este proyecto fue construido bajo el protocolo de seguridad propio de Synalab: quince reglas aplicadas a cada línea de código. Funciona local-first cuando es posible y no envía datos a servidores externos sin consentimiento explícito del usuario.
        </p>
      </div>
    </Container>
  </section>

  <section>
    <Container class="py-16 md:py-20">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold tracking-wider uppercase text-cyan-synalab mb-4">Licencia y uso</p>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-6">Cómo puedes usar este proyecto</h2>

        <div class="p-6 md:p-8 rounded-lg border border-blanco-puro/10 bg-blanco-puro/[0.03] backdrop-blur-sm">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-4">
            <div>
              <p class="text-xs font-semibold tracking-wider uppercase text-slate-muted mb-2">Licencia</p>
              <h3 class="text-lg md:text-xl font-semibold">
                {licenseLabels[data.license] || data.license}
              </h3>
            </div>
            {licenseUrls[data.license] && (
              <a href={licenseUrls[data.license]} target="_blank" rel="noopener noreferrer" class="text-sm text-cyan-synalab hover:text-cyan-synalab/80 transition-colors whitespace-nowrap">
                Ver licencia completa →
              </a>
            )}
          </div>
          <p class="text-base text-blanco-puro/80 leading-relaxed">
            {licenseDescriptions[data.license] || 'Para condiciones de uso, contacta con Synalab.'}
          </p>
        </div>
      </div>
    </Container>
  </section>

  {relatedProjects.length > 0 && (
    <section>
      <Container class="py-16 md:py-20">
        <p class="text-sm font-semibold tracking-wider uppercase text-cyan-synalab mb-4">También del laboratorio</p>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-12">Proyectos relacionados</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedProjects.map((related) => (
            <a href={"/laboratorio/" + related.id} class="group p-8 rounded-lg border border-blanco-puro/10 bg-blanco-puro/[0.03] backdrop-blur-sm hover:border-cyan-synalab/40 hover:bg-blanco-puro/[0.05] transition-all flex flex-col">
              <div class="flex items-center justify-between mb-6">
                <Badge variant={related.data.status} />
                {related.data.version && (
                  <span class="text-xs text-slate-muted font-mono">{related.data.version}</span>
                )}
              </div>
              <h3 class="text-xl font-semibold mb-3 group-hover:text-cyan-synalab transition-colors">
                {related.data.name}
              </h3>
              <p class="text-blanco-puro/70 leading-relaxed flex-grow">
                {related.data.tagline}
              </p>
            </a>
          ))}
        </div>
      </Container>
    </section>
  )}

  <section>
    <Container class="py-20 md:py-28">
      <div class="relative max-w-3xl mx-auto overflow-hidden rounded-2xl border border-blanco-puro/10 bg-blanco-puro/[0.03] backdrop-blur-md p-10 md:p-14">
        <p class="text-sm font-semibold tracking-wider uppercase text-cyan-synalab mb-6">¿Te interesa este proyecto?</p>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-6">Conversemos sobre cómo usarlo.</h2>
        <p class="text-lg text-blanco-puro/80 mb-10 leading-relaxed">
          Si quieres implementar esta herramienta en tu institución, adaptarla a tu contexto, o conocer las condiciones de uso, escríbenos.
        </p>
        <Button href="/contacto" variant="primary" size="lg">Hablemos</Button>
      </div>
    </Container>
  </section>

</Layout>