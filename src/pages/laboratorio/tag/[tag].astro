---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Container from '../../../components/ui/Container.astro';
import TagBadge from '../../../components/ui/TagBadge.astro';
import { slugify } from '../../../lib/slugify';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  const tagMap = new Map<string, { tag: string; projects: typeof projects }>();

  projects.forEach((project) => {
    (project.data.tags || []).forEach((tag) => {
      const slug = slugify(tag);
      if (!tagMap.has(slug)) {
        tagMap.set(slug, { tag, projects: [] });
      }
      tagMap.get(slug)!.projects.push(project);
    });
  });

  return Array.from(tagMap.entries()).map(([slug, { tag, projects }]) => ({
    params: { tag: slug },
    props: {
      tag,
      projects: projects.sort((a, b) => a.data.order - b.data.order),
    },
  }));
}

const { tag, projects } = Astro.props;
---

<Layout
  title={`Etiqueta: ${tag} | Laboratorio`}
  description={`Proyectos del Laboratorio etiquetados como ${tag}.`}
>
  <section>
    <Container class="py-20 md:py-24">
      <div class="max-w-3xl">
        
          href="/laboratorio"
          class="text-sm text-cyan-synalab hover:underline mb-6 inline-block"
        >
          ← Volver a Laboratorio
        </a>
        <p class="text-sm font-semibold tracking-wider uppercase text-cyan-synalab mb-4">
          Etiqueta
        </p>
        <div class="flex items-center gap-4 mb-6 flex-wrap">
          <h1 class="text-4xl md:text-5xl font-bold tracking-tight">
            {tag}
          </h1>
          <TagBadge tag={tag} section="laboratorio" linked={false} size="md" />
        </div>
        <p class="text-lg text-blanco-puro/80">
          {projects.length} {projects.length === 1 ? 'proyecto' : 'proyectos'} con esta etiqueta.
        </p>
      </div>
    </Container>
  </section>

  <section>
    <Container class="pb-24">
      <div class="max-w-5xl grid grid-cols-1 md:grid-cols-2 gap-6">
        {projects.map((project) => (
          <a
            href={`/laboratorio/${project.slug}`}
            class="group block p-6 rounded-2xl border border-blanco-puro/10 hover:border-cyan-synalab/40 transition-all hover:-translate-y-1"
          >
            <h2 class="text-xl md:text-2xl font-semibold tracking-tight mb-3 group-hover:text-cyan-synalab transition-colors">
              {project.data.title}
            </h2>
            <p class="text-base text-blanco-puro/80 leading-relaxed mb-4">
              {project.data.tagline}
            </p>
            {project.data.tags && project.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {project.data.tags.map((t) => (
                  <TagBadge tag={t} section="laboratorio" size="sm" />
                ))}
              </div>
            )}
          </a>
        ))}
      </div>
    </Container>
  </section>
</Layout>