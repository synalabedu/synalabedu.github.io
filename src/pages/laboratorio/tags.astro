---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/ui/Container.astro';
import TagBadge from '../../components/ui/TagBadge.astro';

const projects = await getCollection('projects', ({ data }) =>
  data.status === 'published'
);

const tagCounts = new Map<string, number>();
projects.forEach((project) => {
  (project.data.tags || []).forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});

const tagsOrdered = Array.from(tagCounts.entries()).sort((a, b) => {
  if (b[1] !== a[1]) return b[1] - a[1];
  return a[0].localeCompare(b[0]);
});
---

<Layout
  title="Etiquetas | Laboratorio"
  description="Todas las etiquetas usadas en proyectos del Laboratorio."
>
  <section>
    <Container class="py-20 md:py-24">
      <div class="max-w-3xl">
        <a
          href="/laboratorio"
          class="text-sm text-cyan-synalab hover:underline mb-6 inline-block"
        >
          ← Volver a Laboratorio
        </a>
        <p class="text-sm font-semibold tracking-wider uppercase text-cyan-synalab mb-4">
          Laboratorio
        </p>
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-6">
          Todas las etiquetas
        </h1>
        <p class="text-lg text-blanco-puro/80 mb-12">
          {tagsOrdered.length} {tagsOrdered.length === 1 ? 'etiqueta' : 'etiquetas'} en uso.
        </p>

        {tagsOrdered.length === 0 ? (
          <p class="text-blanco-puro/60">
            Aún no hay proyectos etiquetados.
          </p>
        ) : (
          <div class="flex flex-wrap gap-3">
            {tagsOrdered.map(([tag, count]) => (
              <div class="flex items-center gap-2">
                <TagBadge tag={tag} section="laboratorio" size="md" />
                <span class="text-sm text-blanco-puro/60">{count}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </Container>
  </section>
</Layout>